<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Regla de visibilidad para usuarios generales (Odoo 19) -->
    <record id="rule_metabase_dashboard_user_visibility" model="ir.rule">
        <field name="name">Metabase Dashboard: Visibilidad de Tableros</field>
        <field name="model_id" ref="model_metabase_dashboard"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">
            [
                '|',
                    ('user_ids', '=', user.id),
                '|',
                    ('group_ids', 'in', user.all_group_ids.ids),
                '&amp;',
                    ('user_ids', '=', False),
                    ('group_ids', '=', False)
            ]
        </field>
    </record>

    <!-- Regla de acceso total para Administradores del Sistema -->
    <record id="rule_metabase_dashboard_manager_all" model="ir.rule">
        <field name="name">Metabase Dashboard: Acceso Total Administradores</field>
        <field name="model_id" ref="model_metabase_dashboard"/>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
